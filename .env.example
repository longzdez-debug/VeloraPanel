VELORA_GSI_HOST=127.0.0.1
VELORA_GSI_PORT=27100
VELORA_GSI_TOKEN=change-me
VELORA_TICK_HZ=20
VELORA_DASHBOARD_HOST=127.0.0.1
VELORA_DASHBOARD_PORT=8765
VELORA_DATA_DIR=data
# Keep OS input disabled until you have verified the route and safety behavior.
VELORA_INPUT_ENABLED=false
VELORA_INPUT_REQUIRE_FOREGROUND=true
VELORA_PROCESS_START_TIMEOUT=30
VELORA_WATCHDOG_ENABLED=true
VELORA_WATCHDOG_MAX_RESTARTS=3
VELORA_WATCHDOG_BACKOFF=5
